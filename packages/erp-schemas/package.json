{
  "name": "@pdfme-erp/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "ERP-specific schema plugins for pdfme (line items table, grouped table, watermark, calculated field, etc.)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "jest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@pdfme/common": "workspace:*",
    "@pdfme/pdf-lib": "workspace:*",
    "expr-eval-fork": "^3.0.1",
    "dompurify": "^3.0.0",
    "signature_pad": "^4.2.0"
  },
  "devDependencies": {
    "@pdfme/generator": "workspace:*",
    "@pdfme/schemas": "workspace:*",
    "typescript": "^6.0.2",
    "@types/dompurify": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-jest-resolver": "^2.0.1",
    "@types/jest": "^29.5.14"
  },
  "jest": {
    "resolver": "ts-jest-resolver",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
